@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysConfigsModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    var id = string.Empty;
    var isReadonly = string.Empty;
    if (Model != null)
    {
        if (!string.IsNullOrEmpty(Model.ConfigKey) && !string.IsNullOrEmpty(Model.ConfigKey))
        {
            isReadonly = "readonly";
            id = Model.ConfigValue + Model.ConfigKey;
        }
    }
}
@Html.Hidden("ID", id)
<div id="Message">

    <div class="form-group">
        @Html.HiddenFor(model => model.ConfigId)
        <div class="col-md-12">
            @Html.TitleFor(model => model.ConfigKey, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.ConfigKey, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Sys_Configs_ConfigKey") })
            @Html.ValidationMessageFor(model => model.ConfigKey, "", new { @class = "text-danger" })
        </div>

    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.ConfigValue, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.ConfigValue, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Sys_Configs_ConfigValue") })
            @Html.ValidationMessageFor(model => model.ConfigValue, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.ConfigDesc, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.ConfigDesc, new { rows = 3, @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Sys_Configs_ConfigDesc") })
            @Html.ValidationMessageFor(model => model.ConfigDesc, "", new { @class = "text-danger" })
        </div>
    </div>

</div>

<script type="text/javascript">
    $(function() {
        var readonly = "@isReadonly";

        if (readonly.length > 0) {
            $("input[type='text'][id$='AppKey']").attr(readonly, "readonly");
        }
    });
</script>