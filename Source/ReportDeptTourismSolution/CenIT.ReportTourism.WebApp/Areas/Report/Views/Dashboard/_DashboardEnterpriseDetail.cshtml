@model System.Data.DataTable
@using System.Data
@using CenIT.ReportTourism.Models.Report
@if (Model.Rows.Count == 0) { <p class="text-muted">@DashboardText.Get("NoEnterpriseIndicators")</p> }
else {
    <p><b>@Model.Rows[0]["EnterpriseName"]</b> · @DashboardText.Get("Month") @Convert.ToDateTime(Model.Rows[0]["ForMonth"]).ToString("MM/yyyy")</p>
    <p class="text-muted small">@DashboardText.Get("RawValuesNote")</p>
    <div class="table-responsive"><table class="table table-striped table-condensed"><thead><tr><th scope="col">@DashboardText.Get("Code")</th><th scope="col">@DashboardText.Get("Filter_Metric")</th><th scope="col">@DashboardText.Get("RawUnit")</th><th scope="col" class="text-right">@DashboardText.Get("InPeriod")</th><th scope="col" class="text-right">@DashboardText.Get("DeclaredPrevious")</th><th scope="col" class="text-right">@DashboardText.Get("DeclaredAnnualPlan")</th></tr></thead><tbody>
        @foreach (DataRow row in Model.Rows) {
            <tr><td>@row["Code"]</td><td>@row["Targets"]</td><td>@row["Unit"]</td>
            @foreach (var key in new[] { "PerformInPeriod","PerformPreviousPeriod","AccumulatedBeginingOfYear" }) {
                <td class="text-right" title="@(row[key] == DBNull.Value ? DashboardText.Get("Analysis_NoData") : Convert.ToString(row[key],System.Globalization.CultureInfo.InvariantCulture))">@DashboardNumber.Amount(row[key] == DBNull.Value ? (decimal?)null : Convert.ToDecimal(row[key]))</td>
            }</tr>
        }
    </tbody></table></div>
}
