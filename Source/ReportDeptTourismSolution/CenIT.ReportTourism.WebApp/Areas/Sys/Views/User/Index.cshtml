@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("User_Title");
}

@section Title
{
    @ViewBag.Title
}

@section Action
{
    @Html.Button(true, "AddUser", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-sm btn-success pull-right" })
}

<div class="row">
    <div class="col-sm-12">
        <div class="col-sm-12 table-responsive">
            <table id="DSUser" class="table table-bordered table-striped" width="100%" data-industry-permissions-title="@AppProcessor.Messagor.GetMessage("User_IndustryPermissions_Title")">
                <thead>
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("User_Label_FullName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("User_Label_UserName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section CustomJS
{
    <script src="@Url.Content("~/Areas/Sys/Views/User/User.js?v=20261012_2")"></script>
}
