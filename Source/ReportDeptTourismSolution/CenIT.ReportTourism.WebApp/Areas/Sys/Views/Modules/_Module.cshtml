@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysModuleModel

@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.ModuleId)

<div id="AppModule">
    <div class="form-group">
        <div class="col-md-3">
            @Html.TitleFor(model => model.ModuleName, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.ModuleName, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("AppModule_Label_ModuleName") })
            @Html.ValidationMessageFor(model => model.ModuleName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-5">
            @Html.TitleFor(model => model.MainController, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.MainController, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("AppModule_Label_MainController") })
            @Html.ValidationMessageFor(model => model.MainController, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.ModuleView, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.ModuleView, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("AppModule_Label_ModuleView") })
            @Html.ValidationMessageFor(model => model.ModuleView, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-3">
            @*<label class="control-label col-md-12">@AppProcessor.Messagor.GetMessage("Menu_Label_Icon")</label>*@
            <button type="button" style="margin-top: 10px;" class="btn btn-default fa-3x iconpicker" data-iconset="fontawesome" role="iconpicker" id="iconpicker" data-icon="@Model.Icon"></button>
            @Html.HiddenFor(model => model.Icon, new { @class = "form-control", Value = Model.Icon })
            @Html.ValidationMessageFor(model => model.Icon, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-9">
            @Html.TitleFor(model => model.Description, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.Description, new { rows = "2", @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("AppModule_Label_Description") })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.ModuleFileZip, new { @class = "control-label" })
            @Html.FileFor(model => model.ModuleFileZip, ".zip", true, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("AppModule_Label_ZipFile") })
            @Html.ValidationMessageFor(model => model.ModuleFileZip, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#iconpicker').iconpicker();
    });
    $('#iconpicker').on('change',
        function (e) {
            $("#Icon").val(e.icon);
        });
</script>
@Html.RenderScripts(ScriptPosition.BodyInside)