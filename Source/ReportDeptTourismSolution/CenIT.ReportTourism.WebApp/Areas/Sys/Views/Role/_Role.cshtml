@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysRoleModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.RoleId)

<div class="form-group">
    <div class="col-md-12">
        @Html.TitleFor(model => model.Name, new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Name, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Role_Label_Name") })
        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
    </div>
</div>