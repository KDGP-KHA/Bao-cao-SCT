@model CenIT.ReportTourism.Models.Report.DashboardNavigationModel
@using CenIT.ReportTourism.Models.Report
@{
    var filters = Model.Filters ?? new CenIT.ReportTourism.Models.Report.DashboardFilters();
    var route = new { year = filters.Year, month = filters.Month, reportType = filters.ReportType, areaId = filters.AreaId,
        economicSectorId = filters.EconomicSectorId, industryId = filters.IndustryId,
        enterpriseId = filters.EnterpriseId, metric = filters.Metric };
}
@* Rendered inside .nav-tabs-custom by each page; the filter form is the tab content. *@
<a class="dashboard-skip-link" href="#dashboard-content">@DashboardText.Get("SkipFilters")</a>
<nav class="nav-tabs-custom dashboard-navigation" aria-label="@DashboardText.Get("ReportNavigation")"><ul class="nav nav-tabs">
    <li class="@(Model.Active == "Overview" ? "active" : "")">
        <a href="@Url.Action("Index", "Dashboard", route)" aria-current="@(Model.Active == "Overview" ? "page" : null)"><i class="fa fa-bar-chart text-light-blue" aria-hidden="true"></i> <span>@DashboardText.Get("Nav_Overview")</span></a>
    </li>
    <li class="@(Model.Active == "Analysis" ? "active" : "")">
        <a href="@Url.Action("Analysis", "Dashboard", route)" aria-current="@(Model.Active == "Analysis" ? "page" : null)"><i class="fa fa-sitemap text-aqua" aria-hidden="true"></i> <span>@DashboardText.Get("Analysis_Title")</span></a>
    </li>
    <li class="@(Model.Active == "Warnings" ? "active" : "")">
        <a href="@Url.Action("Warnings", "Dashboard", route)" aria-current="@(Model.Active == "Warnings" ? "page" : null)"><i class="fa fa-exclamation-triangle text-yellow" aria-hidden="true"></i> <span>@DashboardText.Get("Nav_Warnings")</span></a>
    </li>
    <li class="@(Model.Active == "Progress" ? "active" : "")">
        <a href="@Url.Action("Progress", "Dashboard", route)" aria-current="@(Model.Active == "Progress" ? "page" : null)"><i class="fa fa-list-alt text-green" aria-hidden="true"></i> <span>@DashboardText.Get("Progress_Title")</span></a>
    </li>
</ul></nav>
@if (ViewBag.IsIndustryRestricted == true)
{
    <p class="text-muted small" role="note">@DashboardText.Get("IndustryScope"). @DashboardText.Get("IndustryGrantNote")</p>
}

<div class="modal fade" id="dashboard-enterprise-detail" tabindex="-1" role="dialog" aria-labelledby="dashboard-detail-title">
    <div class="modal-dialog modal-lg" role="document"><div class="modal-content">
        <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="@DashboardText.Get("Close")">&times;</button><h4 id="dashboard-detail-title" class="modal-title">@DashboardText.Get("EnterpriseIndicators")</h4></div>
        <div class="modal-body" aria-live="polite"></div>
    </div></div>
</div>
