@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("EnterpriseType_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    bg-primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "EnterpriseType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "EnterpriseType_OnProcessSuccess(data, 'AddEnterpriseType')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_EnterpriseType")
        </div>
    }
}