@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateProvinceModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ProvinceId)
@{
    if (Model.ProvinceId > 0)
    {
        <div class="form-group">
            <div class="col-md-3">
                @Html.TitleFor(model => model.ProvinceCode, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.ProvinceCode, new { @class = "col-md-12", @readonly = "readonly" })
            </div>
            <div class="col-md-9">
                @Html.TitleFor(model => model.ProvinceName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.ProvinceName, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Province_Label_Name") })
                @Html.ValidationMessageFor(model => model.ProvinceName, "", new { @class = "text-danger" })
            </div>
        </div>
    }
    else
    {
        @Html.HiddenFor(model => model.ProvinceCode)
        <div class="form-group">
            <div class="col-md-12">
                @Html.TitleFor(model => model.ProvinceName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.ProvinceName, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Province_Label_Name") })
                @Html.ValidationMessageFor(model => model.ProvinceName, "", new { @class = "text-danger" })
            </div>
        </div>
        @*<div class="form-group" style="display: none">
                <div class="col-md-3">
                    @Html.TitleFor(model => model.ProvinceCode, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.ProvinceCode, new { @class = "col-md-12" })
                </div>
            </div>*@
    }
}
