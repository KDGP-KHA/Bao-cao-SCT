@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.SysModule.Areas.Sys.Models.AppConfigModel

@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    var id = string.Empty;
    var isReadonly = string.Empty;
    if (Model != null)
    {
        if (!string.IsNullOrEmpty(Model.AppValue) && !string.IsNullOrEmpty(Model.AppKey))
        {
            isReadonly = "readonly";
            id = Model.AppValue + Model.AppKey;
        }
    }
}
@Html.Hidden("ID", id)
<div id="Config">

    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.AppKey, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.AppKey, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Message_Label_AppKey") })
            @Html.ValidationMessageFor(model => model.AppKey, "", new { @class = "text-danger" })
        </div>

    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.AppValue, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.AppValue, new { rows = 3, @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Message_Label_AppValue") })
            @Html.ValidationMessageFor(model => model.AppValue, "", new { @class = "text-danger" })
        </div>
    </div>

</div>

<script type="text/javascript">
    $(function() {
        var readonly = "@isReadonly";

        if (readonly.length > 0) {
            //$("input[type='text'][id$='AppValue']").attr(readonly, "readonly");
            $("input[type='text'][id$='AppKey']").attr(readonly, "readonly");
        }
    });
</script>