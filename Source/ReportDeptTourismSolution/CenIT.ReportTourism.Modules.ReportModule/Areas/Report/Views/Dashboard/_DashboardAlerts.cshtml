@model CenIT.ReportTourism.Models.Report.DashboardModel
@using System.Linq

@{
    var bucket10 = Math.Max(0, Model.Alerts.DeclineOver10 - Model.Alerts.DeclineOver20);
    var bucket20 = Math.Max(0, Model.Alerts.DeclineOver20 - Model.Alerts.DeclineOver30);
    var bucket30 = Model.Alerts.DeclineOver30;
    var maxVal = Math.Max(1, Math.Max(bucket10, Math.Max(bucket20, bucket30)));
}

<div class="box box-default">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-exclamation-triangle text-danger"></i> Cảnh báo biến động</h3>
        <div class="box-tools pull-right">
            <a href="@Url.Action("Warnings", "Dashboard", Model.Filters)" class="btn btn-box-tool text-primary">
                Bảng cảnh báo <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    <div class="box-body">
        <p class="text-muted" style="font-size: 12px; margin-bottom: 15px;">
            <i class="fa fa-info-circle"></i> Doanh thu công nghiệp giảm sâu so với tháng trước
        </p>
        @if (!Model.HasComparisonData)
        {
            <div class="text-center text-muted" style="padding: 30px 0;">
                Chưa có dữ liệu tháng trước với giá trị gốc dương để đánh giá cảnh báo.
            </div>
        }
        else
        {
            <div class="alert-bucket-list">
                <div class="alert-bucket-item" style="margin-bottom: 14px;">
                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                        <span><i class="fa fa-warning text-yellow"></i> Giảm trên 10% đến 20%</span>
                        <strong>@bucket10 <small class="text-muted">DN</small></strong>
                    </div>
                    <div class="progress progress-xs" style="margin-bottom: 0;">
                        <div class="progress-bar progress-bar-yellow" style="width: @((bucket10 * 100 / maxVal))%"></div>
                    </div>
                </div>
                <div class="alert-bucket-item" style="margin-bottom: 14px;">
                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                        <span><i class="fa fa-warning text-orange" style="color: #f39c12;"></i> Giảm trên 20% đến 30%</span>
                        <strong>@bucket20 <small class="text-muted">DN</small></strong>
                    </div>
                    <div class="progress progress-xs" style="margin-bottom: 0;">
                        <div class="progress-bar progress-bar-warning" style="width: @((bucket20 * 100 / maxVal))%"></div>
                    </div>
                </div>
                <div class="alert-bucket-item" style="margin-bottom: 8px;">
                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                        <span><i class="fa fa-exclamation-circle text-red"></i> Giảm trên 30% (mức nghiêm trọng)</span>
                        <strong class="text-red">@bucket30 <small class="text-muted">DN</small></strong>
                    </div>
                    <div class="progress progress-xs" style="margin-bottom: 0;">
                        <div class="progress-bar progress-bar-danger" style="width: @((bucket30 * 100 / maxVal))%"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
