@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysUserModel

@{
    ViewBag.Title = $"Ngưng hoạt động người dùng - [{Model.FullName} - {Model.UserName}]";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section ModalType{
    bg-red
}

@section FormBody{

    @using (Ajax.BeginForm("DeActive", "User", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User_OnProcessSuccess(data, 'DeActiveUser')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.UserId)
        @Html.HiddenFor(model => model.UserName)
        @Html.HiddenFor(model => model.FullName)

        <h4> @Html.Raw(ViewBag.ConfirmMessage)</h4>
        <hr/>
        <div class="form-group">
            <div class="col-md-12">
                @Html.TitleFor(model => model.Reason, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Reason, new { rows = "2", @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label") })
                @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
            </div>
        </div>
    }
}