     <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <membership defaultProvider="AppMembership">
      <providers>
        <clear />
        <add name="AppMembership" type="CenIT.ReportTourism.AppMembership.AppMemberShipProvider" />
        <!--<add name="VNPTEmailMembership" type="VNPTKhanhHoa.Providers.VNPTEmailMembership.VNPTEmailMembershipProvider" />-->
        <!--<add name="SSOMembership" type="VNPTKhanhHoa.Providers.SSOMembership.SsoMemberShipProvider" />-->
