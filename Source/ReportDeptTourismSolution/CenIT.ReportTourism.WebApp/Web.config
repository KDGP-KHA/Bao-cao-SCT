     <TiSunService defaultProvider="SysProvider" enableTrace="false" templateDirectory="">
          <providers>
               <clear />
               <add name="SysProvider" type="TiSun.SqlDataProvider, TiSun" connectionStringName="BaseApp" generatedNamespace="CenIT.BaseApp.DataAccess" generateLazyLoads="true" />
               <add name="ReportTourismProvider" type="TiSun.SqlDataProvider, TiSun" connectionStringName="ReportTourismDB" generatedNamespace="CenIT.ReportTourism.DataAccess" generateLazyLoads="true" />
