@model CenIT.ReportTourism.Models.Report.DashboardProgressModel
@using CenIT.ReportTourism.Models.Report
@using System.Linq
@{
    ViewBag.Title = DashboardText.Get("Progress_Title");
}
@section Title {
    @ViewBag.Title
}
@section HeadCss {
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/morris/morris.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.css")" />
}
@{
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    Func<int, int, string> ratioWidth = (received, assigned) =>
        (assigned > 0 ? Math.Min(100m, 100m * received / assigned) : 0m).ToString("0.#", invariant);
}
<div class="management-dashboard dashboard-progress-page">
    <div class="nav-tabs-custom">
        @Html.Partial("_DashboardNavigation", new CenIT.ReportTourism.Models.Report.DashboardNavigationModel { Active = "Progress", Filters = Model.Filters })
        <div class="tab-content">
            @Html.Partial("_DashboardFilters", Model.FilterOptions)
        </div>
    </div>

    <div id="dashboard-content" class="box box-default" tabindex="-1"><div class="box-body">
        <p><b>@DashboardText.Get("CoverageRate"): @(Model.Assigned > 0 ? DashboardNumber.Percent(Model.CoveragePercent) : "—")</b></p>
        <div class="progress" role="progressbar" aria-label="@DashboardText.Get("CoverageRate")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ratioWidth(Model.Received, Model.Assigned)"><div class="progress-bar progress-bar-green" style="width: @ratioWidth(Model.Received, Model.Assigned)%"></div></div>
    </div></div>
    <div class="row dashboard-equal-row dashboard-kpi-row">
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-gray">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Received) <sup>/ @DashboardNumber.Count(Model.Assigned)</sup></h3>
                    <p><b>@DashboardText.Get("Progress_HasData")</b></p>
                </div>
                <div class="small-box-footer">@DashboardText.Get("Progress_NoData"): @DashboardNumber.Count(Model.Assigned-Model.Received) DN · <b>@(Model.Assigned > 0 ? DashboardNumber.Percent(Model.CoveragePercent) : "—")</b></div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-gray">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Complete) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>@DashboardText.Get("CompleteThreeMetrics")</b></p>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-yellow">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.Incomplete) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>@DashboardText.Get("Progress_MissingCodes")</b></p>
                </div>
                <div class="small-box-footer">@DashboardText.Get("Progress_Review"): @DashboardNumber.Count(Model.Conflicts) DN</div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6">
            <div class="small-box bg-gray">
                <div class="inner">
                    <h3>@DashboardNumber.Count(Model.FileAnyType) <sup>@DashboardText.Get("Enterprises")</sup></h3>
                    <p><b>@DashboardText.Get("Progress_FileAnyType") <small>@DashboardText.Get("AllTypes")</small></b></p>
                </div>
                <div class="small-box-footer">@DashboardText.Get("FileLate"): @DashboardNumber.Count(Model.FileLate)</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-success">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-line-chart text-green" aria-hidden="true"></i> @DashboardText.Get("Progress_ReceiptTrend")</h3>
                </div>
                <div class="box-body">

                    <div class="text-right" role="group" aria-label="@DashboardText.Get("ChartMode")"><button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="observation-trend-chart" data-mode="rate">@DashboardText.Get("RateMode")</button> <button type="button" class="btn btn-default btn-xs dashboard-chart-toggle" data-chart-id="observation-trend-chart" data-mode="count">@DashboardText.Get("EnterpriseFileCount")</button></div>
                    <div id="observation-trend-chart" data-rate-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { DashboardText.Get("CoverageRate") }))" data-labels="@(Newtonsoft.Json.JsonConvert.SerializeObject(new[] { DashboardText.Get("ChartReceived"), DashboardText.Get("FilesAllTypes") }))" data-empty="@DashboardText.Get("ChartEmpty")" class="chart dashboard-chart" role="img" aria-label="@DashboardText.Get("Progress_TrendAria") @Model.Filters.ReportType"></div>
                    <script type="application/json" class="md-chart-data" data-chart="observation-trend">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReceiptTrend))</script>
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-link dashboard-values-toggle" data-toggle="collapse" data-target="#observation-trend-values" aria-expanded="false" aria-controls="observation-trend-values"><i class="fa fa-table" aria-hidden="true"></i> @DashboardText.Get("ChartValues")</button>
                    <div id="observation-trend-values" class="collapse">
                        <div class="table-responsive">
                            <table class="table table-condensed table-striped">
                                <thead><tr><th scope="col">@DashboardText.Get("Month")</th><th scope="col" class="text-right">@DashboardText.Get("Progress_ReceivedEnterprise")</th><th scope="col">@DashboardText.Get("CoverageTotal")</th><th scope="col">@DashboardText.Get("FilesAllTypes")</th></tr></thead>
                                <tbody>@foreach (var point in Model.ReceiptTrend) { <tr><td>@point.Month</td><td class="text-right">@DashboardNumber.Amount(point.Value)</td><td>@DashboardNumber.Percent(point.Rate) / @DashboardNumber.Count(point.Expected)</td><td>@DashboardNumber.Count(point.Files)</td></tr> }</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-tasks text-aqua" aria-hidden="true"></i> @DashboardText.Get("Progress_MetricPresence")</h3>
                </div>
                <div class="box-body dashboard-breakdown-grid">
                    @foreach (var item in Model.MetricPresence)
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-aqua" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row dashboard-equal-row">
        <div class="col-xs-12 col-md-6">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-pie-chart" aria-hidden="true"></i> @DashboardText.Get("Analysis_SectorTitle")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Progress_ReceivedAssignedShort")</span></div>
                </div>
                <div class="box-body">
                    @if (!Model.Sectors.Any()) { <p class="text-muted no-margin">@DashboardText.Get("Progress_NoAssigned")</p> }
                    @if (Model.Sectors.Count > 6) { <p class="text-muted small">@DashboardText.Get("Showing") 6 / @DashboardNumber.Count(Model.Sectors.Count)</p> }
                    @foreach (var item in Model.Sectors.Take(6))
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-green" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-md-6">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-map-marker" aria-hidden="true"></i> @DashboardText.Get("Progress_ByArea")</h3>
                    <div class="box-tools pull-right"><span class="label label-default">@DashboardText.Get("Progress_ReceivedAssignedShort")</span></div>
                </div>
                <div class="box-body">
                    @if (!Model.Areas.Any()) { <p class="text-muted no-margin">@DashboardText.Get("Progress_NoAssigned")</p> }
                    @if (Model.Areas.Count > 10) { <p class="text-muted small">@DashboardText.Get("Showing") 10 / @DashboardNumber.Count(Model.Areas.Count)</p> }
                    @foreach (var item in Model.Areas.Take(10))
                    {
                        <div class="progress-group">
                            <span class="progress-text">@item.Name</span>
                            <span class="progress-number"><b>@DashboardNumber.Count(item.Received)</b> / @DashboardNumber.Count(item.Assigned)</span>
                            <div class="progress sm"><div class="progress-bar progress-bar-green" style="width: @ratioWidth(item.Received, item.Assigned)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-default">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-list-alt" aria-hidden="true"></i> @DashboardText.Get("Progress_Worklist")</h3>
                    <div class="box-tools pull-right"><span id="progress-enterprise-count" class="badge bg-light-blue">@DashboardNumber.Count(Model.TotalRows) @DashboardText.Get("Enterprises")</span></div>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table id="dashboard-progress-enterprises" class="table table-bordered table-striped table-hover table-condensed" width="100%"
                               data-url="@Url.Action("ProgressEnterprises", "Dashboard", new { year=Model.Filters.Year, month=Model.Filters.Month, reportType=Model.Filters.ReportType, areaId=Model.Filters.AreaId, economicSectorId=Model.Filters.EconomicSectorId, industryId=Model.Filters.IndustryId, enterpriseId=Model.Filters.EnterpriseId, status=Model.Filters.Status })"
                               data-detail-url="@Url.Action("EnterpriseDetail", "Dashboard", new { year=Model.Filters.Year, month=Model.Filters.Month, reportType=Model.Filters.ReportType })"
                               data-has-data="@DashboardText.Get("Progress_HasData")" data-no-data="@DashboardText.Get("Progress_NoData")"
                               data-complete="@DashboardText.Get("Progress_ThreeValues")" data-review="@DashboardText.Get("Progress_Review")"
                               data-enterprises="@DashboardText.Get("Enterprises")">
                            <thead><tr><th scope="col">@DashboardText.Get("Enterprise")</th><th scope="col">@DashboardText.Get("Area")</th><th scope="col">@DashboardText.Get("Progress_TypeData")</th><th scope="col">@DashboardText.Get("Progress_MissingCodes")</th><th scope="col">@DashboardText.Get("DataErrors")</th><th scope="col">@DashboardText.Get("FileAnyTypeLabel")</th><th scope="col">@DashboardText.Get("Reason")</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div id="progress-enterprise-error" class="alert alert-warning" role="alert" hidden>@DashboardText.Get("ProgressLoadFailed") <button id="progress-enterprise-retry" type="button" class="btn btn-default btn-sm">@DashboardText.Get("Retry")</button></div>
                    <script type="application/json" id="dashboard-progress-data">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new { data = Model.Enterprises, total = Model.TotalRows, start = ((long)Model.Filters.Page - 1) * Model.PageSize, pageSize = Model.PageSize }, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }))</script>
                </div>
                <div class="box-footer clearfix">
                    <span class="label label-default" title="@(ViewBag.IsIndustryRestricted == true ? DashboardText.Get("IndustryScope") : DashboardText.Get("Overview_ProvinceWide"))">@DashboardText.Get("OutsideRegistry"): @DashboardNumber.Count(Model.Orphans)</span>
                </div>
            </div>
        </div>
    </div>

</div>
@section CustomJS {
    <script src="@Url.Content("~/Contents/plugins/morris/raphael-min.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/morris/morris.js")"></script>
    <script src="@Url.Content("~/Contents/plugins/management-dashboard/management-dashboard.js")"></script>
}
