      </providers>
    </membership>
    <!--<customErrors mode="On" />-->
    <compilation targetFramework="4.8" debug="true">
      <buildProviders />
      <assemblies />
    </compilation>
    <httpRuntime targetFramework="4.5.2" maxRequestLength="1073741824" />
    <!--<httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
    </httpModules>-->
          <globalization uiCulture="en" culture="en-GB" />
          <authentication mode="Forms">
               <forms loginUrl="/Account/Login" protection="All" timeout="30" name=".ASPXAUTH" path="/" requireSSL="false" slidingExpiration="true" defaultUrl="/" cookieless="UseDeviceProfile" enableCrossAppRedirects="false" />
          </authentication>
          <httpHandlers>
               <add path="*.js" verb="GET,HEAD" type="System.Web.StaticFileHandler" />
               <add path="*.css" verb="GET,HEAD" type="System.Web.StaticFileHandler" />
               <add path="*.cshtml" verb="*" type="System.Web.HttpNotFoundHandler" />
               <add path="Reserved.ReportViewerWebControl.axd" verb="*" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" validate="false" />
          </httpHandlers>
     </system.web>
     <mscorlib>
          <!-- ... -->
          <cryptographySettings>
               <cryptoNameMapping>
                    <cryptoClasses>
                         <cryptoClass RSASHA256SignatureDescription="Security.Cryptography.RSAPKCS1SHA256SignatureDescription, Security.Cryptography, Version=1.6.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
                    </cryptoClasses>
                    <nameEntry name="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256" class="RSASHA256SignatureDescription" />
               </cryptoNameMapping>
          </cryptographySettings>
     </mscorlib>
     <runtime>
          <!-- Keep HTTP compatibility at 4.5.2 while using modern outbound TLS on the installed 4.8 runtime. -->
          <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false;Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
