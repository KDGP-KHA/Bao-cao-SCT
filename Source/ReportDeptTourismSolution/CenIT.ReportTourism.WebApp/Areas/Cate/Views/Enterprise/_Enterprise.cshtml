@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateEnterpriseModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.EnterpriseId)

<div id="Enterprise">

    <div class="form-group row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.OwnerEnterpriseName, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.OwnerEnterpriseName, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Owner") })
            @Html.ValidationMessageFor(model => model.OwnerEnterpriseName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.BusinessName, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.BusinessName, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_BusinessName") })
            @Html.ValidationMessageFor(model => model.BusinessName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-2">
            @Html.TitleFor(model => model.TaxCode, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.TaxCode, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_TaxCode") })
            @Html.ValidationMessageFor(model => model.TaxCode, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.EconomicSectorId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.EconomicSectorId, new SelectList(Model.ListEconomicSector, "Value", "Text"), "", new { @class = "col-md-12 form-control", onchange = "OnChangeCombo(this, '#EconomicSectorName');" })
            <br /> @Html.ValidationMessageFor(model => model.EconomicSectorId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.EconomicSectorName)
        </div>
        <div class="col-md-5">
            @Html.TitleFor(model => model.EnterpriseTypeId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.EnterpriseTypeId, new SelectList(Model.ListEnterpriseType, "Value", "Text"), "", new { @class = "col-md-12 form-control", onchange = "OnChangeCombo(this, '#EnterpriseTypeName');" })
            @Html.ValidationMessageFor(model => model.EnterpriseTypeId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.EnterpriseTypeName)
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-5">
            @Html.TitleFor(model => model.IndustryIds, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ListIndustryId, new SelectList(Model.ListBusinessIndustry, "Value", "Text"), "", new { multiple = true, @class = "col-md-12 form-control" })
            @Html.ValidationMessageFor(model => model.ListIndustryId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.IndustryIds)
        </div>
        <div class="col-md-7">
            @Html.TitleFor(model => model.TypeBusiness, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ListTypeBusinessId, new SelectList(Model.ListTypeBusiness, "Value", "Text"), "", new { multiple = true, @class = "col-md-12 form-control" })
            @Html.ValidationMessageFor(model => model.ListTypeBusinessId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.TypeBusiness)
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.MainProductId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.MainProductId, new SelectList(Model.ListMainProduct, "Value", "Text"), "", new { @class = "col-md-12 form-control" })
            @Html.ValidationMessageFor(model => model.MainProductId, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-3">
            @Html.TitleFor(model => model.EnterpriseStatusId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.EnterpriseStatusId, new SelectList(Model.ListEnterpriseStatus, "Value", "Text"), "", new { @class = "col-md-12 form-control", onchange = "OnChangeCombo(this, '#EnterpriseStatusName');" })
            <br /> @Html.ValidationMessageFor(model => model.EnterpriseStatusId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.EnterpriseStatusName)
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-4">
            @Html.TitleFor(model => model.Email, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Email, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Email") })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.Website, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Website, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Website") })
            @Html.ValidationMessageFor(model => model.Website, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2">
            @Html.TitleFor(model => model.Phone, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Phone, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Phone") })
            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.ListCertificateFiles, new { @class = "control-label" })
            @{
                if (!string.IsNullOrEmpty(Model.ListPathCertificateFiles))
                {
                    @Html.Raw(Model.ListPathCertificateFiles)
                }
            }

            @Html.FileFor(model => model.ListCertificateFiles, ".docx,.pdf,.xlsx,.xls", true, new { @class = "col-md-12" })
            @Html.ValidationMessageFor(model => model.ListCertificateFiles, "", new { @class = "text-danger" })
            <br />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-4">
            @Html.TitleFor(model => model.ProvinceId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.ListProvinces, "Value", "Text"), "", new { @class = "col-md-12 form-control", onchange = "OnChangeProvince(this, 'select#WardId');" })
            @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.ProvinceName)
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.WardId, new { @class = "control-label" })
            @Html.DropDownListFor(model => model.WardId, new SelectList(Model.ListWards, "Value", "Text"), "", new { @class = "col-md-12 form-control", onchange = "OnChangeCombo(this, '#WardName');" })
            @Html.ValidationMessageFor(model => model.WardId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.WardName)
        </div>
        <div class="col-md-5">
            @Html.TitleFor(model => model.BusinessAddress, new { @class = "control-label" })
            @Html.TextBoxFor(model => model.BusinessAddress, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_Address") })
            @Html.ValidationMessageFor(model => model.BusinessAddress, "", new { @class = "text-danger" })
            @* Bỏ ô "Đường/Thôn tổ" trên giao diện; giữ giá trị hiện tại để khi lưu không bị xoá *@
            @Html.HiddenFor(model => model.StreetName)
        </div>
    </div>

    <div class="box box-body no-shadow">
        <h4 class="box-title text-bold text-blue">@AppProcessor.Messagor.GetMessage("Enterprise_Label_LegalRepresentation")</h4>
        <div class="form-group row">
            <div class="col-md-5">
                @Html.TitleFor(model => model.LegalRepresentationName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.LegalRepresentationName, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_LegalRepresentationName") })
                @Html.ValidationMessageFor(model => model.LegalRepresentationName, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-3">
                @Html.TitleFor(model => model.LegalRepresentationPhone, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.LegalRepresentationPhone, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_LegalRepresentationPhone") })
                @Html.ValidationMessageFor(model => model.LegalRepresentationPhone, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.TitleFor(model => model.LegalRepresentationEmail, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.LegalRepresentationEmail, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Enterprise_Label_LegalRepresentationEmail") })
                @Html.ValidationMessageFor(model => model.LegalRepresentationEmail, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    @{
        if (Model.EnterpriseId > 0)
        {
            <div class="form-group row">
                <div class="col-md-12">
                    @Html.TitleFor(model => model.Reason, new { @class = "control-label" })
                    @Html.TextAreaFor(model => model.Reason, new { rows = "2", @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                </div>
            </div>
        }
        else
        {
            @Html.HiddenFor(model => model.Reason)
        }
    }
</div>

<script type="text/javascript">
    //debugger;
    $(document).ready(function () {
        $("a[name='DownloadRefDoc']").on('click',
            function () {
                var url = $(this).data('href');
                $.ajax({
                    type: 'GET',
                    url: url,
                    success: function (response) {
                        if (typeof response != "undefined" && response != null && response.status) {
                            window.location = response.downloadPath;
                        } else if (typeof response != "undefined" && response != null && !response.status) {
                            eval(response.message);
                        }
                    }
                });
            });

        OnChangeProvince('#Enterprise select#ProvinceId', '#Enterprise select#WardId');
        ////$("#@Html.IdFor(model => model.ListIndustryId)").val(@Model.IndustryIds).trigger('change');
        @{
            if (!string.IsNullOrEmpty(Model.IndustryIds))
            {
                @Html.Raw($"$('#Enterprise #{Html.IdFor(model => model.ListIndustryId)}').val('{Model.IndustryIds}'.split(',')).trigger('change');")
            }
            if (!string.IsNullOrEmpty(Model.TypeBusiness))
            {
                @Html.Raw($"$('#Enterprise #{Html.IdFor(model => model.ListTypeBusinessId)}').val('{Model.TypeBusiness}'.split(',')).trigger('change');")
            }
        }

        // Gắn sau khi đã chọn lại ngành ở trên => lần tải form không gọi lại danh sách sản phẩm chính
        $('#@Html.IdFor(model => model.ListIndustryId)').on('change', function () {
            OnChangeIndustries(this, 'select#@Html.IdFor(model => model.MainProductId)');
        });
    });

</script>
@Html.RenderScripts(ScriptPosition.BodyInside)