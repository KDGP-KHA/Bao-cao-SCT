@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Cate.CateWardModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.WardId)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@{
    if (Model.WardId > 0)
    {
        <div class="form-group">
            <div class="col-md-6">
                @Html.TitleFor(model => model.ProvinceId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "", new { @class = "col-md-12" })
                @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-3">
                @Html.TitleFor(model => model.WardCode, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.WardCode, new { @class = "form-control col-md-12", @readonly = "readonly" })
            </div>
            <div class="col-md-9">
                @Html.TitleFor(model => model.WardName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.WardName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Ward_Label_Name") })
                @Html.ValidationMessageFor(model => model.WardName, "", new { @class = "text-danger" })
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            <div class="col-md-6">
                @Html.TitleFor(model => model.ProvinceId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "", new { @class = "col-md-12" })
                @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                @Html.HiddenFor(model => model.WardCode)
                @Html.TitleFor(model => model.WardName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.WardName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Ward_Label_Name") })
                @Html.ValidationMessageFor(model => model.WardName, "", new { @class = "text-danger" })
            </div>
        </div>
    }

    @*else
    {
        @Html.HiddenFor(model => model.WardCode)
        <div class="form-group">
            <div class="col-md-12">
                @Html.TitleFor(model => model.WardName, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.WardName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Ward_Label_Name") })
                @Html.ValidationMessageFor(model => model.WardName, "", new { @class = "text-danger" })
            </div>
        </div>
    }*@
}

<script type="text/javascript">
    function OnChangeProvince(cbbProvince, cbbWard) {
        if ($("#ProvinceName").length > 0) {
            $("#ProvinceName").val($(cbbProvince).children("option:selected").text());
        }
        $(cbbWard).empty();
        $(".chosen-select").trigger("chosen:updated");
        var selected = $(cbbProvince).val();
        var url = "/Cate/Wards/WardViaProvince?provinceId=" + selected;
        $.ajax({
            type: "GET",
            url: url,
            dataType: "JSON",
            success: function (response) {
                $(cbbWard).append('<option value=""></option>');
                $.each(response.Wards,
                    function (index, item) {
                        $(cbbWard).append('<option value="' + item.ProvinceId + '">' + item.ProvinceName + "</option>");
                    });
            }
        });
    }
</script>