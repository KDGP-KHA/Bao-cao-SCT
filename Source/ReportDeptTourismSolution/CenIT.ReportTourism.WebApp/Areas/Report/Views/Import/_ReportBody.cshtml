@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.TourismReportModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.EnableSignDigitalDoc)

<div id="DataImport">
    @{
        if (DateTime.Now.Day > Model.DayDeadlineSendReport && DateTime.Now.Day <= Model.DayDeadlineSendReportLate)
        {
            <div class="alert alert-danger alert-dismissible" style="border-radius: unset;">
                @if (Model.IsEnterpriseUser)
                {
                    <h4><i class="icon fa fa-bullhorn"></i> Quá hạn gửi báo cáo tháng @DateTime.Now.ToString("MM/yyyy")!</h4>
                    <p>Đã qua hạn gửi báo cáo lúc <b>23h59 ngày @Model.DayDeadlineSendReport</b> hàng tháng. Báo cáo gửi sau ngày <b>@Model.DayDeadlineSendReport</b> sẽ được xem là trễ hạn.</p>
                }
                else
                {
                    <h4><i class="icon fa fa-bullhorn"></i> Quá hạn nhập báo cáo tháng @DateTime.Now.ToString("MM/yyyy")!</h4>
                    <p>Đã qua hạn nhập báo cáo lúc <b>23h59 ngày @Model.DayDeadlineSendReport</b> hàng tháng. Báo cáo nhập sau ngày <b>@Model.DayDeadlineSendReport</b> sẽ được xem là trễ hạn.</p>
                }
            </div>
            <hr/>
        }
        var visibleInfoSmartCA = string.IsNullOrEmpty(Model.AccessToken) || !Model.EnableSignDigitalDoc ? "hidden" : "";
        var visibleSmartCA = string.IsNullOrEmpty(Model.AccessToken) && Model.EnableSignDigitalDoc ? "" : "hidden";

        <div class="col-md-12 @visibleSmartCA" id="ButtonLoginSmartCA">
            <a id="LoginSmartCA" href="@Url.Action("LoginSmartCA")" data-modal="true" data-modal-id="LoginSmartCA" class="pull-right btn btn-sm btn-default">
                <img class="pull-right" alt="" src="~/Contents/imgs/VNPT SmartCA_sm.png"/>
            </a>
        </div>
    }

    <div class="box box-primary no-footer @visibleInfoSmartCA" id="BoxUserInfo">
        <div class="box-header">
            <h3 class="box-title text-bold">Thông tin tài khoản Smart CA</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="box-body" id="UserInfo">
            @{
                if (!string.IsNullOrEmpty(Model.AccessToken) && Model.EnableSignDigitalDoc)
                {
                    Html.RenderAction("UserInfo");
                }
            }
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.EnterpriseId, new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            @Html.DropDownListFor(model => model.EnterpriseId, new SelectList(Model.ListEnterprises, "Value", "Text", Model.EnterpriseId), "", new { @class = "form-control none-select2", style = "width: 100%;" })
            @Html.ValidationMessageFor(model => model.EnterpriseId, "", new { @class = "text-danger" })
        </div>
        @Html.LabelFor(model => model.ForMonth, new { @class = "control-label col-md-2", style = "white-space: nowrap;" })
        <div class="col-md-2">
            <div class="input-group">
                <div class="input-group-addon" style="background-color: #eee; cursor: not-allowed;"><i class="fa fa-calendar"></i></div>
                <input type="text" id="ForMonthDisplay" class="form-control" value="@Model.ForMonth.ToString("MM/yyyy")" disabled="disabled" style="cursor: not-allowed; background-color: #eee;" placeholder="MM/yyyy" />
                @Html.HiddenFor(model => model.ForMonth, new { id = "ForMonth" })
            </div>
        </div>
        @Html.HiddenFor(model => model.EnterpriseName)
        @Html.HiddenFor(model => model.EnterpriseTypeBusiness, new { id = "EnterpriseTypeBusiness" })
    </div>

    <div class="form-group">
        <div class="col-md-12 report-type-tab-row">
            @Html.HiddenFor(model => model.TypeReport, new { id = "TypeReportSelect" })
            @Html.HiddenFor(model => model.TypeReportName, new { id = "TypeReportName" })
            <ul id="TypeReportTabs" class="nav nav-tabs report-type-tabs">
                @foreach (var type in Model.ListTypeBusiness ?? new List<System.Web.UI.WebControls.ListItem>())
                {
                    <li data-type="@type.Value"><a href="javascript:void(0)">@type.Text</a></li>
                }
            </ul>
        </div>
    </div>

    <div class="form-group">
        @Html.HiddenFor(model => model.IsEdit)

        @{
            if (Model.IsEdit)
            {
                @Html.Partial("_EditReport", Model.ListDataImports)
            }
            else
            {
                <div id="TypeReport">
                    @*@Html.Partial("_AccommodationServices")*@
                </div>
            }
        }

    </div>
</div>

<script src="~/Areas/Report/Views/Import/_ReportBody.js"></script>

<script type="text/javascript">

    $("<style>.report-type-tab-row{margin-top:12px}.report-type-tabs{display:flex;justify-content:flex-start;align-items:flex-end;flex-wrap:nowrap;width:100%;border-bottom:1px solid #ddd}.report-type-tabs li{display:none;float:none!important;white-space:nowrap}.report-type-tabs li a{cursor:pointer;padding:10px 24px;font-size:14px}</style>").appendTo("head");

    $(document).ready(function() {
        var $container = $("#modal_AddReport").length ? $("#modal_AddReport") : $("#DataImport");
        var $typeTabs = $container.find('#TypeReportTabs');
        function configureTypeTabs(typeBusiness) {
            var types = (typeBusiness || "").toString().split(',').map(function (value) { return $.trim(value); }).filter(function (value) { return value === "1" || value === "2" || value === "3"; });
            $typeTabs.children('li').each(function () { $(this).toggle(types.indexOf($(this).data('type').toString()) >= 0); });
            var selected = $container.find('#TypeReportSelect').val();
            if (types.indexOf(selected) < 0) selected = types.length ? types[0] : "";
            $container.find('#TypeReportSelect').val(selected);
            $typeTabs.children('li').removeClass('active').filter('[data-type="' + selected + '"]').addClass('active');
            $container.find('#TypeReportName').val($typeTabs.children('li.active').text());
        }

        $typeTabs.off('click.typeReport', 'li').on('click.typeReport', 'li', function () {
            var $tab = $(this);
            if (!$tab.is(':visible') || $tab.hasClass('active')) return;
            $container.find('#TypeReportSelect').val($tab.data('type'));
            $typeTabs.children('li').removeClass('active');
            $tab.addClass('active');
            $container.find('#TypeReportName').val($tab.text());
            var entId = $enterpriseSelect.val(), entText = $enterpriseSelect.find('option:selected').text();
            if (entId) triggerLoadReportForm(entId, entText);
        });

        @{
            if (string.IsNullOrEmpty(Model.AccessToken) && Model.EnableSignDigitalDoc)
            {
                @Html.Raw("var a = document.createElement('a');a.style.display = 'none';a.href = '" + Url.Action("LoginSmartCA") + "';a.class = 'btn hidden';a.setAttribute('data-modal', 'true');a.setAttribute('data-modal-id', 'LoginSmartCA');document.body.appendChild(a);a.click();")
                @Html.Raw("$('#modal_AddReport button[type=\"submit\"]').prop('disabled', true);")
                ;
            }
        }
        var $enterpriseSelect = $container.find("select#EnterpriseId");
        if ($enterpriseSelect.data("select2")) {
            $enterpriseSelect.select2("destroy");
        }
        var $modalContainer = $enterpriseSelect.closest(".modal");
        $enterpriseSelect.select2({
            placeholder: "-- Chọn hoặc tìm kiếm doanh nghiệp --",
            allowClear: true,
            language: "vi",
            width: "100%",
            dropdownParent: $modalContainer.length ? $modalContainer : $("#modal_AddReport"),
            ajax: {
                url: "@Url.Action("SearchEnterprisesSelect2", "Import", new { area = "Report" })",
                dataType: "json",
                delay: 300,
                data: function (params) {
                    return {
                        q: params.term || "",
                        typeBusiness: "",
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.results,
                        pagination: {
                            more: data.pagination ? data.pagination.more : false
                        }
                    };
                },
                cache: true
            },
            minimumInputLength: 0
        });

        $enterpriseSelect.off('select2:open').on('select2:open', function () {
            setTimeout(function () {
                var $searchField = $('.select2-container--open .select2-search__field');
                if ($searchField.length > 0 && !$searchField.val()) {
                    $searchField.trigger('input');
                }
            }, 50);
        });

        var lastLoadedKey = "";
        var reportFormDrafts = {};
        var reportFormDom = {};
        function reportDraftKey(enterpriseId, typeReport) {
            return (enterpriseId || "") + "_" + (typeReport || "");
        }
        function saveCurrentReportDraft(enterpriseId, typeReport) {
            if (!enterpriseId || !typeReport) return;
            var values = {};
            $container.find("#TypeReport input[name], #TypeReport select[name], #TypeReport textarea[name]").each(function () {
                var $field = $(this), name = $field.attr("name");
                if (!name || $field.is(":checkbox,:radio") && !$field.is(":checked")) return;
                values[name] = $field.val();
            });
            if (Object.keys(values).length) reportFormDrafts[reportDraftKey(enterpriseId, typeReport)] = values;
            // Giữ cả DOM của biểu mẫu: các dòng mặt hàng được thêm động không thể
            // dựng lại chỉ bằng các input ẩn khi người dùng quay lại tab.
            var key = reportDraftKey(enterpriseId, typeReport);
            var $content = $container.find("#TypeReport").children();
            if ($content.length) reportFormDom[key] = $content.detach();
            $container.find("form#AddReport").data("reportFormDrafts", reportFormDrafts);
        }
        function preloadReportDraft(enterpriseId, typeReport, forMonthVal) {
            var key = reportDraftKey(enterpriseId, typeReport);
            if (!enterpriseId || reportFormDrafts[key]) return;
            var url = '@Url.Action("LoadViewTypeReport", "Import", new { area = "Report" })?enterpriseId=' + encodeURIComponent(enterpriseId) + '&typeReport=' + encodeURIComponent(typeReport) + (forMonthVal ? ('&forMonth=' + encodeURIComponent(forMonthVal)) : '');
            $.get(url, function (html) {
                var values = {};
                $("<div>").html(html).find("input[name], select[name], textarea[name]").each(function () {
                    var $field = $(this), name = $field.attr("name");
                    if (name && (!$field.is(":checkbox,:radio") || $field.is(":checked"))) values[name] = $field.val();
                });
                if (Object.keys(values).length) reportFormDrafts[key] = values;
                $container.find("form#AddReport").data("reportFormDrafts", reportFormDrafts);
            });
        }
        window.GetReportDraftForSubmit = function (enterpriseId, typeReport, forMonthVal) {
            var key = reportDraftKey(enterpriseId, typeReport);
            if (reportFormDrafts[key]) return reportFormDrafts[key];
            var url = '@Url.Action("LoadViewTypeReport", "Import", new { area = "Report" })?enterpriseId=' + encodeURIComponent(enterpriseId) + '&typeReport=' + encodeURIComponent(typeReport) + (forMonthVal ? ('&forMonth=' + encodeURIComponent(forMonthVal)) : '');
            $.ajax({ url: url, async: false, success: function (html) {
                var values = {};
                $("<div>").html(html).find("input[name], select[name], textarea[name]").each(function () {
                    var $field = $(this), name = $field.attr("name");
                    if (name && (!$field.is(":checkbox,:radio") || $field.is(":checked"))) values[name] = $field.val();
                });
                if (Object.keys(values).length) reportFormDrafts[key] = values;
            } });
            return reportFormDrafts[key];
        };
        function restoreReportDraft(enterpriseId, typeReport) {
            var values = reportFormDrafts[reportDraftKey(enterpriseId, typeReport)];
            if (!values) return;
            $.each(values, function (name, value) {
                var $field = $container.find("#TypeReport [name='" + name + "']");
                if (!$field.length) return;
                $field.val(value);
                if ($field.is("select")) $field.trigger("change");
            });
        }
        function triggerLoadReportForm(entId, entText) {
            var forMonthVal = $container.find("#ForMonth").val();
            var typeReportVal = $container.find("#TypeReportSelect").val();
            var loadedTypeReport = $container.data("loadedTypeReport");
            if (loadedTypeReport && loadedTypeReport !== typeReportVal) {
                saveCurrentReportDraft(entId, loadedTypeReport);
            }
            var currentKey = (entId || "") + "_" + (forMonthVal || "") + "_" + (typeReportVal || "");
            if (currentKey === lastLoadedKey && $container.find("#TypeReport").children().length > 0) {
                return;
            }
            lastLoadedKey = currentKey;

            var domKey = reportDraftKey(entId, typeReportVal);
            if (reportFormDom[domKey]) {
                $container.find("#TypeReport").empty().append(reportFormDom[domKey]);
                restoreReportDraft(entId, typeReportVal);
                $container.data("loadedTypeReport", typeReportVal);
                return;
            }

            var isEnableSignDigitalDoc = @(Model.EnableSignDigitalDoc ? "1" : "0");
            var isLoginSmartCA = @(string.IsNullOrEmpty(Model.AccessToken) ? "0" : "1");

            if (!entId || entId === "") {
                $container.find('#EnterpriseName').val("");
                $container.find("#TypeReport").empty();
                $('#modal_AddReport button[type="submit"]').prop('disabled', true);
                return;
            }

            if (isEnableSignDigitalDoc == 0 || isLoginSmartCA == 1) {
                $('#modal_AddReport button[type="submit"]').removeAttr('disabled');
            }

            if (entText) {
                $container.find('#EnterpriseName').val(entText);
            }

            var urlLoadViewTypeReport = '@Url.Action("LoadViewTypeReport", "Import", new { area = "Report" })?enterpriseId=' + encodeURIComponent(entId) + (forMonthVal ? ("&forMonth=" + encodeURIComponent(forMonthVal)) : "") + (typeReportVal ? ("&typeReport=" + encodeURIComponent(typeReportVal)) : "");

            $container.find("#TypeReport").html("<div class='text-center' style='padding:25px;'><i class='fa fa-spinner fa-spin fa-2x text-primary'></i><div style='margin-top:10px; font-weight:bold;'>Đang tải mẫu báo cáo...</div></div>");

            $container.find("#TypeReport").load(urlLoadViewTypeReport, function(response, status, xhr) {
                if (status === "error") {
                    lastLoadedKey = "";
                    $container.find("#TypeReport").html("<div class='alert alert-danger'>Lỗi tải biểu mẫu (" + xhr.status + ": " + xhr.statusText + "). Vui lòng thử lại.</div>");
                    $('#modal_AddReport button[type="submit"]').prop('disabled', true);
                } else {
                    if (isEnableSignDigitalDoc == 0 || isLoginSmartCA == 1) {
                        $('#modal_AddReport button[type="submit"]').removeAttr('disabled');
                    }
                    restoreReportDraft(entId, typeReportVal);
                    $container.data("loadedTypeReport", typeReportVal);
                }
            });
        }

        $enterpriseSelect.off("change.report select2:select.report").on("change.report select2:select.report", function(e) {
            var entId = $(this).val();
            var entText = $(this).find("option:selected").text();
            if ((!entId || entId === "") && e && e.params && e.params.data) {
                entId = e.params.data.id;
                entText = e.params.data.text;
                if (!$(this).find("option[value='" + entId + "']").length) {
                    var newOption = new Option(entText, entId, true, true);
                    $(this).append(newOption);
                }
                $(this).val(entId);
            }
            if (e && e.params && e.params.data && e.params.data.typeBusiness) {
                var bizVal = e.params.data.typeBusiness;
                $(this).data('typeBusiness', bizVal);
                $container.find('#EnterpriseTypeBusiness').val(bizVal);
                configureTypeTabs(bizVal);
                $.each(bizVal.toString().split(','), function (_, type) { preloadReportDraft(entId, $.trim(type), $container.find("#ForMonth").val()); });
            }
            triggerLoadReportForm(entId, entText);
        });

        $enterpriseSelect.off("select2:clear.report").on("select2:clear.report", function() {
            triggerLoadReportForm("", "");
        });

        var selectedEntVal = $enterpriseSelect.val();
        if (selectedEntVal && selectedEntVal !== "") {
            var selectedEntText = $enterpriseSelect.find("option:selected").text();
            configureTypeTabs($enterpriseSelect.find("option:selected").data('typeBusiness') || $container.find('#EnterpriseTypeBusiness').val());
            $.each(($enterpriseSelect.find("option:selected").data('typeBusiness') || $container.find('#EnterpriseTypeBusiness').val() || '').toString().split(','), function (_, type) { preloadReportDraft(selectedEntVal, $.trim(type), $container.find("#ForMonth").val()); });
            triggerLoadReportForm(selectedEntVal, selectedEntText);
        } else {
            configureTypeTabs("");
            $('#modal_AddReport button[type="submit"]').prop('disabled', true);
        }
    });

    String.format = function() {
        var s = arguments[0];
        for (var i = 0; i < arguments.length - 1; i++) {
            var reg = new RegExp("\\{" + i + "\\}", "gm");
            s = s.replace(reg, arguments[i + 1]);
        }
        return s;
    };

    function signOutSmartCA() {
        $.ajax({
            method: "GET",
            url: "@Url.Action("SignoutSmartCA", "Import")",
            async: false
        }).done(function(response) {
            if (response.status) {
                $("#BoxUserInfo").addClass('hidden');
                $("#ButtonLoginSmartCA").removeClass('hidden');
                $("#UserInfo").empty();
                $('#modal_AddReport button[type="submit"]').prop('disabled', true);
            }
        });
    }
</script>

<script type="text/javascript">

    function LoginSmartCA_OnProcessSuccess(response, formId) {
        if (response.status != undefined) {
            if (response.status) {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function() {
                        if (response.status != undefined) {
                            eval(response.message);
                            if (response.errorCode == 1) {
                                signOutSmartCA();
                            }
                            if (response.status) {
                                $("#UserInfo").parents('section.content')
                                    .find('div.col-md-5.hidden, div.col-md-7.hidden')
                                    .removeClass('hidden');
                                $("#BoxUserInfo").removeClass('hidden');
                                $("#ButtonLoginSmartCA").addClass('hidden');
                                $("#UserInfo").load("@Url.Action("UserInfo")");
                                $('#modal_AddReport button[type="submit"]').removeAttr("disabled");
                            }
                            response.status = undefined;
                        }
                    });
            } else {
                eval(response.message);
                response.status = undefined;
            }
        } else {
            $("#ModalContent #modal_" + formId + " #ContentLogin").html(response);
        }
    }

</script>

@Html.RenderScripts(ScriptPosition.BodyInside)
