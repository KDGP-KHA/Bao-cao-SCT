@using TSFramework.App.Processors
@model CenIT.ReportTourism.Models.Sys.SysUserModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.UserId)

<div id="User">
    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.FullName, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-user-circle-o"></i>
                </span>
                @Html.TextBoxFor(model => model.FullName, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_FullName") })
            </div>
            @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-5">
            @Html.TitleFor(model => model.UserName, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-user-o"></i>
                </span>
                @{
                    if (Model.UserId > 0)
                    {
                        @Html.TextBoxFor(model => model.UserName, new { disabled = "disabled", @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_UserName") })
                        @Html.HiddenFor(model => model.UserName)
                    }
                    else
                    {
                        @Html.TextBoxFor(model => model.UserName, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_UserName") })
                    }
                }

            </div>
            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
        </div>
    
        <div class="col-md-7">
            @Html.TitleFor(model => model.Email, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-envelope"></i>
                </span>
                @Html.TextBoxFor(model => model.Email, new { @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_Email") })
            </div>
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row" id="GroupPanel">
        @Html.HiddenFor(model => model.RoleIDs)
        <div class="col-md-12">
            <label class="control-label">@AppProcessor.Messagor.GetMessage("User_Label_Group") </label>
            <div class="row col-md-12">
                @foreach (var item in Model.Roles)
                {
                    var sChecked = string.IsNullOrEmpty(Model.RoleIDs) || Model.RoleIDs.Split(',').ToList().IndexOf(item.RoleId.ToString()) == -1 ? "" : "checked";
                    <div class="checkbox col-md-4">
                        <input id="group-@item.RoleId" name="form-field-checkbox" type="checkbox" aria-label="@item.Name" onclick="OnEventChecked(this)" value="@item.RoleId" @sChecked />
                        <label style="padding-left: 5px;" for="group-@item.RoleId">@item.Name</label>
                    </div>
                }
            </div>
        </div>
        @Html.ValidationMessageFor(model => model.RoleIDs, "", new { @class = "text-danger" })
    </div>

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Reason, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.Reason, new { rows = "2", @class = "col-md-12 form-control", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label") })
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
            <p />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#GroupPanel input[type=checkbox]').each(function () {
            var roleIDs = $('input[type="hidden"][id$="RoleIDs"]').val().split(',');

            var idGroup = $(this).val();
            var index = roleIDs.indexOf((idGroup));

            if (index > -1) {
                this.checked = true;
            }
        });
    });

    function OnEventChecked(chk) {
        var roleIDs = $('input[type="hidden"][id$="RoleIDs"]').val().split(',');

        var index;
        if ($(chk)[0].checked) {
            index = roleIDs.indexOf(($(chk).val()));
            if (index == -1) {
                roleIDs.push($(chk).val());
            }
        } else {
            index = roleIDs.indexOf(($(chk).val()));
            roleIDs.splice(index, 1);
        }
        $('input[type="hidden"][id$="RoleIDs"]').val(roleIDs);
    }
</script>