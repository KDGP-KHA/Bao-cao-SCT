@using TSFramework.App.Processors
@model CenIT.ReportTourism.Modules.SysModule.Areas.Sys.Models.ResetPasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@*@Html.HiddenFor(model => model.FullName)*@
@*@Html.HiddenFor(model => model.Email)*@
@*@Html.HiddenFor(model => model.UserName)*@
<div id="User">
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.FullName, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-user-circle-o"></i>
                </span>
                @Html.TextBoxFor(model => model.FullName, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_FullName"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-5">
            @Html.TitleFor(model => model.UserName, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-user-o"></i>
                </span>
                @Html.TextBoxFor(model => model.UserName, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_UserName"), @readonly = true })
            </div>
        </div>
        <div class="col-md-7">
            @Html.TitleFor(model => model.Email, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-envelope"></i>
                </span>
                @Html.TextBoxFor(model => model.Email, new { @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_Email"), @readonly = true })
            </div>
        </div>
    </div>
    @*<div class="form-group">
            @Html.TitleFor(model => model.CurrentPassword, new { @class = "control-label" })
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-addon"><i class="fa fa-key"></i></span>
                    @Html.TextBoxFor(model => model.CurrentPassword, new { @class = "col-xs-6", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Current_Password"), type = "password" })
                </div>
                @Html.ValidationMessageFor(model => model.CurrentPassword, "", new { @class = "text-danger" })
            </div>
        </div>*@
    <div class="form-group">
        <div class="col-md-6">
            @Html.TitleFor(model => model.NewPassword, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-key"></i>
                </span>
                @Html.TextBoxFor(model => model.NewPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_New_Password"), type = "password" })
                <a class="input-group-addon btn text-blue" href="javascript:void(0);" onclick="_showPassword($('#NewPassword'));">
                    <i class="fa fa-eye-slash"></i>
                </a>
            </div>
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
        @Html.TitleFor(model => model.ConfirmPassword, new { @class = "control-label" })
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-key"></i>
                </span>
                @Html.TextBoxFor(model => model.ConfirmPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_ConfirmPassword"), type = "password" })
                <a class="input-group-addon btn text-blue" href="javascript:void(0);" onclick="_showPassword($('#ConfirmPassword'));">
                    <i class="fa fa-eye-slash"></i>
                </a>
            </div>
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Reason, new { @class = "control-label" })
            @Html.TextAreaFor(model => model.Reason, new { rows = "2", @class = "col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label") })
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
        </div>
    </div>
</div>