<script type="text/javascript">
    debugger;
    $(document).ready(function () {
        $(document).on('shown.bs.modal', function () {
            initSelect2();
        });
    });

    function initSelect2() {
        var arrSelectedUser = JSON.parse('@Html.Raw(Model.SelectedUser)');
        $select = $('select#ListUserIds');
        $select.empty().trigger('change');
        arrSelectedUser.forEach(item => {
            const option = new Option(
                item.text,
                item.id,
                true,
                true
            );

            $select.append(option);
        });

        $select.select2({
            placeholder: "Nhập để tìm Tài khoản...",
            minimumInputLength: 2, // Minimum characters to type before a search triggers
            allowClear: true,
            closeOnSelect: false,
            width: 'element',
            ajax: {
                url: '@Url.Action("SearchUser")', // Your API endpoint
                dataType: 'json',
                delay: 250, // Wait 250ms after typing stops before sending the request (debouncing)

                // 1. Prepare query parameters sent to the server
                data: function (params) {
                    return {
                        q: params.term, // The search term typed by the user
                        moduleId: '@Model.ModuleId',
                        page: params.page || 1 // Support for infinite scrolling/pagination
                    };
                },

                // 2. Parse the server response into the format Select2 expects
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    // Select2 requires an array of objects, each containing an 'id' and 'text' property
                    // Maps your server's payload schema to the required Select2 schema
                    var formattedResults = $.map(data.results, function (item) {
                        return {
                            id: item.id,       // Value submitted with the form
                            text: item.text    // Text displayed in the dropdown
                        };
                    });

                    return {
                        results: formattedResults,
                        pagination: {
                            // True if there are more pages of data left to load
                            more: (params.page * 30) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });
    }
</script>

